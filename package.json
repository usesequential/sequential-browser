{
  "name": "@usesequential/browser",
  "version": "1.0.0",
  "description": "The Sequential browser SDK as an npm package: analytics and session replay, the same code as the script tag.",
  "keywords": [
    "sequential",
    "analytics",
    "session replay",
    "product analytics",
    "autocapture",
    "browser"
  ],
  "homepage": "https://www.usesequential.com/docs/browser-npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesequential/sequential-browser.git"
  },
  "bugs": {
    "url": "https://github.com/usesequential/sequential-browser/issues"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {}
}
